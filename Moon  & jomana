https://jomana-moon-default-rtdb.firebaseio.com/<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ortak Oda ve Etkileşim</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; padding: 16px; background: #f4f5f7; color: #111; }
    .box { max-width: 540px; margin: 0 auto; background: #fff; padding: 16px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    input, button { padding: 10px; border-radius: 8px; border: 1px solid #ccc; font-size: 15px; }
    button { background: #1a73e8; color: #fff; border: none; cursor: pointer; font-weight: bold; }
    .row { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
    .row input { flex: 1; min-width: 120px; }
    .panel { background: #eef3fe; padding: 12px; border-radius: 8px; margin-bottom: 12px; font-size: 14px; }
    .stage { background: #fff8e7; border: 1px solid #f0d78c; padding: 12px; border-radius: 8px; margin-bottom: 12px; }
    .stage-btn { background: #2e7d32; margin-top: 8px; }
    #chat { height: 210px; overflow-y: auto; border: 1px solid #e0e0e0; border-radius: 8px; padding: 10px; margin-bottom: 10px; background: #fafafa; }
    .msg { margin-bottom: 8px; padding: 6px 10px; border-radius: 8px; background: #fff; border: 1px solid #ececec; }
  </style>
</head>
<body>
  <div class="box">
    <h2>Ortak Oda (Canlı Hareket + Etkileşim + Sohbet)</h2>

    <div class="row">
      <input id="roomInput" placeholder="Oda kodu" value="oda123" />
      <input id="nickInput" placeholder="Adın" value="Ben" />
      <button onclick="connectRoom()">Bağlan</button>
    </div>

    <div class="panel">
      <div><strong>Karşıdaki Kişinin Aksiyonu / Hareketi:</strong> <span id="peerAction">Henüz hareket yok</span></div>
      <div class="row" style="margin-top: 8px; margin-bottom: 0;">
        <input id="actionInput" placeholder="Yaptığın aksiyonu/hareketi yaz..." />
        <button onclick="sendAction('Hareket yaptı')">Hareket Gönder</button>
      </div>
    </div>

    <div class="stage">
      <div><strong>Ortak Aktivite Alanı:</strong> <span id="sharedActivity">Henüz etkileşim girilmedi</span></div>
      <div class="row" style="margin-top: 8px; margin-bottom: 0;">
        <input id="activityInput" placeholder="Ortak aktiviteye ne ekleyeceksin?" />
        <button class="stage-btn" onclick="interactActivity()">Etkileşim Gir</button>
      </div>
    </div>

    <div id="chat"></div>

    <div class="row" style="margin-bottom: 0;">
      <input id="msgInput" placeholder="Mesaj yaz..." onkeydown="if(event.key==='Enter') sendMsg()" />
      <button onclick="sendMsg()">Gönder</button>
    </div>
  </div>

  <script>
    // Kendi Realtime Database adresini buraya yaz (sonunda / olmadan)
    const FIREBASE_DB_URL = "";
    let poller = null;

    function baseUrl() {
      const room = (document.getElementById("roomInput").value || "oda123").trim();
      return `${FIREBASE_DB_URL.replace(/\/$/, "")}/rooms/${encodeURIComponent(room)}`;
    }

    function appendChat(text) {
      const chat = document.getElementById("chat");
      const div = document.createElement("div");
      div.className = "msg";
      div.textContent = text;
      chat.appendChild(div);
      chat.scrollTop = chat.scrollHeight;
    }

    function connectRoom() {
      if (!FIREBASE_DB_URL) {
        document.getElementById("peerAction").textContent = "FIREBASE_DB_URL boş: iki cihazda canlı paylaşım için Firebase linki eklenmeli.";
        return;
      }
      if (poller) clearInterval(poller);
      syncRoom();
      poller = setInterval(syncRoom, 1200);
      document.getElementById("peerAction").textContent = "Odaya bağlanıldı, canlı dinleniyor...";
    }

    async function sendAction(defaultText) {
      const nick = document.getElementById("nickInput").value || "Kullanıcı";
      const val = document.getElementById("actionInput").value.trim() || defaultText;
      if (!FIREBASE_DB_URL) {
        document.getElementById("peerAction").textContent = `${nick}: ${val}`;
        return;
      }
      await fetch(`${baseUrl()}/lastAction.json`, {
        method: "PUT",
        body: JSON.stringify({ nick, val, t: Date.now() })
      });
      document.getElementById("actionInput").value = "";
      syncRoom();
    }

    async function interactActivity() {
      const nick = document.getElementById("nickInput").value || "Kullanıcı";
      const val = document.getElementById("activityInput").value.trim() || "Ortak alana etkileşim bıraktı";
      if (!FIREBASE_DB_URL) {
        document.getElementById("sharedActivity").textContent = `${nick} -> ${val}`;
        return;
      }
      await fetch(`${baseUrl()}/activity.json`, {
        method: "PUT",
        body: JSON.stringify({ nick, val, t: Date.now() })
      });
      document.getElementById("activityInput").value = "";
      syncRoom();
    }

    async function sendMsg() {
      const input = document.getElementById("msgInput");
      const text = input.value.trim();
      if (!text) return;
      const nick = document.getElementById("nickInput").value || "Kullanıcı";
      input.value = "";
      if (!FIREBASE_DB_URL) {
        appendChat(`${nick}: ${text}`);
        return;
      }
      await fetch(`${baseUrl()}/messages.json`, {
        method: "POST",
        body: JSON.stringify({ nick, text, t: Date.now() })
      });
      syncRoom();
    }

    async function syncRoom() {
      if (!FIREBASE_DB_URL) return;
      const res = await fetch(`${baseUrl()}.json`);
      const data = await res.json();
      if (!data) return;

      if (data.lastAction) {
        document.getElementById("peerAction").textContent = `${data.lastAction.nick}: ${data.lastAction.val}`;
      }
      if (data.activity) {
        document.getElementById("sharedActivity").textContent = `${data.activity.nick} -> ${data.activity.val}`;
      }
      const chat = document.getElementById("chat");
      chat.innerHTML = "";
      if (data.messages) {
        Object.values(data.messages)
          .sort((a, b) => (a.t || 0) - (b.t || 0))
          .forEach(m => appendChat(`${m.nick}: ${m.text}`));
      }
    }
  </script>
</body>
</html>
